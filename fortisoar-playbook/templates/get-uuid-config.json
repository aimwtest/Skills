          "steps": [
            {
              "@type": "WorkflowStep",
              "name": "Combind Connector Data",
              "description": null,
              "arguments": {
                "config": "585f84eb-fd50-456e-870b-feb8bbf952cd",
                "params": {
                  "python_function": "# 從 FortiSOAR variables 取得兩組資料\r\nconnectors = {{vars.steps.List_Installed_Connectors.data.data}}\r\nconnector_configs = {{vars.steps.List_Configurations.data.data}}\r\n\r\n# 建立 connector id 對應表，方便後續查找\r\nconnector_by_id = {\r\n    connector.get(\"id\"): connector\r\n    for connector in connectors\r\n    if connector.get(\"id\") is not None\r\n}\r\n\r\nresult = []\r\n\r\n# 逐筆處理 connector config\r\nfor config_item in connector_configs:\r\n    connector_id = config_item.get(\"connector\")\r\n    connector = connector_by_id.get(connector_id)\r\n\r\n    # 找不到對應 connector 時跳過\r\n    if not connector:\r\n        continue\r\n\r\n    result.append({\r\n            \"config_id\": config_item.get(\"config_id\"),\r\n            \"configuration_id\": config_item.get(\"id\"),\r\n            \"configuration_name\": config_item.get(\"name\"),\r\n            \"connector_id\": connector.get(\"id\"),\r\n            \"connector_name\": connector.get(\"name\")\r\n    })\r\n\r\n# FortiSOAR Code Snippet 最後回傳 result\r\nprint(result)"
                },
                "version": "2.2.1",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": []
              },
